# Data source: "mock" uses the procedural mock generator (default, offline-capable)
# "api" connects to a live FastAPI backend
VITE_DATA_SOURCE=mock

# Base URL for the FastAPI backend (only used when VITE_DATA_SOURCE=api)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL for live ticks (only used when VITE_DATA_SOURCE=api)
VITE_WS_URL=ws://localhost:8000/live
